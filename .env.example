# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Database
# Пароль со спецсимволами (@ $ | ...) percent-encode: @ -> %40, $ -> %24, | -> %7C
DATABASE_URL=postgresql+asyncpg://template_maker:template_maker@postgres:5432/template_maker
# Выделенная схема PostgreSQL — приложение работает только в ней (создаётся автоматически)
DB_SCHEMA=templater

# GigaChat / LLM (leave empty values to disable LLM features)
GIGACHAT_BASE_URL=
GIGACHAT_CERT_B64=
GIGACHAT_KEY_B64=
GIGACHAT_MODEL=GigaChat-3-Ultra

LLM_TIMEOUT=120
LLM_CONCURRENCY=3
LLM_REQUEST_DELAY=2.0
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_DELAY=3.0
