# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# Database
# Хост localhost — для локального запуска без Docker. Docker Compose
# переопределяет DATABASE_DSN своим значением (хост postgres).
# Database — libpq-style key=value DSN. Значения с пробелами/спецсимволами в кавычках:
#   password='p@ss w$rd'   — @ $ / # и пробелы работают без экранирования.
DATABASE_DSN=host=localhost port=5432 dbname=template_maker user=template_maker password=template_maker
# Выделенная схема PostgreSQL — приложение работает только в ней (создаётся автоматически)
DB_SCHEMA=templater

# GigaChat / LLM. Чтобы включить LLM, заполните все три: BASE_URL, CERT_B64, KEY_B64.
# Сертификат и ключ — клиентские PEM-файлы в base64. Ключ должен быть без passphrase:
#   base64 -i client.pem | tr -d '\n'   -> GIGACHAT_CERT_B64
#   base64 -i client.key | tr -d '\n'   -> GIGACHAT_KEY_B64
# Проверка: echo "$GIGACHAT_CERT_B64" | base64 -d | head -c 30
# должно начинаться с -----BEGIN CERTIFICATE-----.
# Если есть .pfx/.p12, сначала сконвертируйте:
#   openssl pkcs12 -in client.pfx -clcerts -nokeys -out client.pem
#   openssl pkcs12 -in client.pfx -nocerts -nodes -out client.key
# Если есть DER .cer/.crt:
#   openssl x509 -inform der -in client.cer -out client.pem
# Пустые значения = LLM-функции отключены (остальное приложение работает).
GIGACHAT_BASE_URL=
GIGACHAT_CERT_B64=
GIGACHAT_KEY_B64=
GIGACHAT_MODEL=GigaChat-3-Ultra

LLM_TIMEOUT=120
LLM_CONCURRENCY=3
LLM_REQUEST_DELAY=2.0
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_DELAY=3.0
# Макс. число вызовов LLM за один проход разметки полей: первый вызов + повторы
# по листьям, которые слабая модель не разметила (обрыв ответа, пустое field,
# путь вместо id). 2 = первый вызов + один повтор.
LLM_FIELD_MAPPING_MAX_ATTEMPTS=2

# Секрет для серверных HMAC-подписей (доказательство, что LLM реально обработала
# шаблон при предпросмотре). Пусто = случайный ключ на процесс: для одного
# воркера/dev работает без настройки. При нескольких воркерах задайте общий
# случайный ключ, иначе предпросмотр и сохранение на разных воркерах не сойдутся
# (тогда просто покажется кнопка «Обработать LLM» — подделать статус нельзя).
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
